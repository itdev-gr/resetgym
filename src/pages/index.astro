---
import Layout from '../layouts/Layout.astro';

const localBusinessSchema = {
	"@context": "https://schema.org",
	"@type": ["LocalBusiness", "ExerciseGym"],
	"@id": "https://www.resetgym.gr/#localbusiness",
	"name": "Reset Gym Γυμναστήριο Χαλάνδρι",
	"alternateName": "Reset Gym",
	"description": "Το Reset Gym είναι γυμναστήριο στο Χαλάνδρι που προσφέρει ολοκληρωμένη εμπειρία γυμναστικής σε σύγχρονο χώρο με έμπειρους γυμναστές. Προσφέρουμε personal training, Pilates Reformer, functional training, cross training και ομαδικά προγράμματα σχεδιασμένα για κάθε επίπεδο και ηλικία. Κάθε ασκούμενος λαμβάνει εξατομικευμένο πλάνο προπόνησης προσαρμοσμένο στους προσωπικούς του στόχους, είτε πρόκειται για ενδυνάμωση, απώλεια βάρους, βελτίωση κινητικότητας ή αθλητική απόδοση. Οι πιστοποιημένοι γυμναστές μας εστιάζουν στη σωστή τεχνική και την ασφαλή εξάσκηση, δημιουργώντας ένα περιβάλλον που εμπνέει συνέπεια και αποτελεσματικότητα. Επισκεφθείτε το γυμναστήριο μας στο Χαλάνδρι και ξεκινήστε σήμερα.",
	"url": "https://www.resetgym.gr/",
	"logo": "https://www.resetgym.gr/logo-full.svg",
	"image": "https://www.resetgym.gr/logo-full.svg",
	"telephone": "+302130319729",
	"email": "resetgym325@gmail.com",
	"priceRange": "€€",
	"address": {
		"@type": "PostalAddress",
		"streetAddress": "Λεωφόρος Μεσογείων 325",
		"addressLocality": "Χαλάνδρι",
		"postalCode": "15231",
		"addressRegion": "Αττική",
		"addressCountry": "GR",
	},
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": 38.00742992254404,
		"longitude": 23.800965868995515,
	},
	"openingHoursSpecification": [
		{
			"@type": "OpeningHoursSpecification",
			"dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
			"opens": "07:30",
			"closes": "22:00",
		},
		{
			"@type": "OpeningHoursSpecification",
			"dayOfWeek": "Saturday",
			"opens": "09:00",
			"closes": "15:00",
		},
	],
	"areaServed": [
		{ "@type": "City", "name": "Χαλάνδρι" },
		{ "@type": "City", "name": "Αγία Παρασκευή" },
		{ "@type": "City", "name": "Βριλήσσια" },
		{ "@type": "City", "name": "Μαρούσι" },
		{ "@type": "City", "name": "Χολαργός" },
	],
	"sameAs": ["https://www.instagram.com/resetfitnessevolution/"],
	"hasOfferCatalog": {
		"@type": "OfferCatalog",
		"name": "Υπηρεσίες Reset Gym",
		"itemListElement": [
			{
				"@type": "Offer",
				"itemOffered": {
					"@type": "Service",
					"name": "Personal Training",
					"description": "Εξατομικευμένη προπόνηση ένας προς έναν με πιστοποιημένο γυμναστή, με στοχευμένο πλάνο για ενδυνάμωση, απώλεια βάρους ή αθλητική απόδοση.",
				},
			},
			{
				"@type": "Offer",
				"itemOffered": {
					"@type": "Service",
					"name": "Pilates Reformer",
					"description": "Μαθήματα Pilates Reformer σε εξειδικευμένα μηχανήματα για βελτίωση στάσης σώματος, ευλυγισίας και ενδυνάμωσης κορμού.",
				},
			},
			{
				"@type": "Offer",
				"itemOffered": {
					"@type": "Service",
					"name": "Functional Training",
					"description": "Λειτουργική προπόνηση που βελτιώνει δύναμη, κινητικότητα και ισορροπία μέσω ασκήσεων που μιμούνται φυσικές κινήσεις της καθημερινότητας.",
				},
			},
			{
				"@type": "Offer",
				"itemOffered": {
					"@type": "Service",
					"name": "Cross Training",
					"description": "Έντονη συνδυαστική προπόνηση με στοιχεία ενδυνάμωσης, αντοχής και πλειομετρικών για ολόπλευρη φυσική κατάσταση.",
				},
			},
			{
				"@type": "Offer",
				"itemOffered": {
					"@type": "Service",
					"name": "Small Group Training",
					"description": "Ομαδικά μαθήματα μικρού αριθμού ατόμων με προσωπική καθοδήγηση γυμναστή και εξατομικευμένη προσοχή σε κάθε ασκούμενο.",
				},
			},
			{
				"@type": "Offer",
				"itemOffered": {
					"@type": "Service",
					"name": "Ενδυνάμωση Strength Training",
					"description": "Προγράμματα ενδυνάμωσης με ελεύθερα βάρη και μηχανήματα για ανάπτυξη μυϊκής μάζας, δύναμης και βελτίωση μεταβολισμού.",
				},
			},
			{
				"@type": "Offer",
				"itemOffered": {
					"@type": "Service",
					"name": "Cardio Training",
					"description": "Καρδιοαναπνευστικές προπονήσεις για βελτίωση αντοχής, κάψιμο λίπους και ενίσχυση της καρδιαγγειακής υγείας.",
				},
			},
			{
				"@type": "Offer",
				"itemOffered": {
					"@type": "Service",
					"name": "Αποκατάσταση Recovery",
					"description": "Προγράμματα αποκατάστασης και κινητικής επανένταξης μετά από τραυματισμό ή για διαχείριση χρόνιων μυοσκελετικών ζητημάτων.",
				},
			},
			{
				"@type": "Offer",
				"itemOffered": {
					"@type": "Service",
					"name": "Αξιολόγηση Φυσικής Κατάστασης",
					"description": "Εκτενής αξιολόγηση φυσικής κατάστασης, σύστασης σώματος και κινητικών προτύπων για τον σχεδιασμό εξατομικευμένου πλάνου προπόνησης.",
				},
			},
			{
				"@type": "Offer",
				"itemOffered": {
					"@type": "Service",
					"name": "Γυμναστική",
					"description": "Ολοκληρωμένα προγράμματα γυμναστικής σε σύγχρονο χώρο, σχεδιασμένα για κάθε επίπεδο και ηλικία με έμφαση στη σωστή τεχνική.",
				},
			},
		],
	},
};
---

<Layout
	title="Γυμναστήριο Χαλάνδρι | Personal Training & Pilates"
	description="Γυμναστήριο στο Χαλάνδρι με personal training, pilates reformer, functional και cross training σε σύγχρονο χώρο με εξατομικευμένα προγράμματα."
>
	<script
		slot="head"
		type="application/ld+json"
		is:inline
		set:html={JSON.stringify(localBusinessSchema)}
	/>

	<!-- ═══════════════════════════════════════════════ -->
	<!-- HERO -->
	<!-- ═══════════════════════════════════════════════ -->
	<section class="relative min-h-screen flex items-center pt-20 overflow-hidden">
		<!-- Background Video -->
		<video
			class="absolute inset-0 w-full h-full object-cover"
			autoplay
			muted
			loop
			playsinline
		>
			<source src="/20226_Man doing pull_Ups on a pull_Up bar_By_Ami_Bornstein_Artlist_HD.mp4" type="video/mp4" />
		</video>
		<!-- Overlay -->
		<div class="absolute inset-0 bg-dark/75"></div>

		<div class="relative max-w-7xl mx-auto px-6 md:px-12 py-24 md:py-32 lg:py-40 w-full">
			<p class="text-lime font-bold text-2xl tracking-[0.3em] uppercase mb-6">
				Fitness Evolution
			</p>
			<h1 class="font-heading text-4xl sm:text-5xl md:text-6xl lg:text-7xl xl:text-8xl uppercase leading-[0.95] tracking-tight max-w-5xl">
				<span class="block">Γυμναστήριο Χαλάνδρι</span>
				<span class="block text-lime text-2xl sm:text-3xl md:text-4xl lg:text-5xl mt-4">Personal Training &amp; Pilates Reformer</span>
			</h1>
			<p class="mt-8 font-heading text-3xl sm:text-4xl md:text-5xl uppercase tracking-tight text-light">
				Εξελίξου<span class="text-lime">.</span>
			</p>
			<p class="mt-4 text-grey text-lg md:text-xl max-w-2xl leading-relaxed">
				Η καλύτερη εκδοχή σου σε περιμένει.
			</p>
			<div class="mt-12 flex flex-col sm:flex-row gap-4">
				<a
					href="#pillars"
					class="inline-block bg-lime text-dark font-bold text-sm tracking-wider uppercase px-8 py-4 hover:translate-x-1 hover:-translate-y-1 transition-transform duration-150"
				>
					Ξεκίνα τώρα
				</a>
				<a
					href="#manifesto"
					class="inline-block border border-light/20 text-light font-bold text-sm tracking-wider uppercase px-8 py-4 hover:border-light/50 transition-colors duration-150"
				>
					Μάθε περισσότερα
				</a>
				<a
					href="/epikoinonia"
					class="inline-block bg-lime text-dark font-bold text-sm tracking-wider uppercase px-8 py-4 hover:translate-x-1 hover:-translate-y-1 transition-transform duration-150"
				>
					Γίνε μέλος
				</a>
			</div>
		</div>
	</section>

	<!-- ═══════════════════════════════════════════════ -->
	<!-- 4 PILLARS -->
	<!-- ═══════════════════════════════════════════════ -->
	<section id="pillars" class="py-24 md:py-32 lg:py-40">
		<div class="max-w-7xl mx-auto px-6 md:px-12">

			<h2 class="font-heading text-3xl sm:text-4xl md:text-5xl uppercase tracking-tight mb-16 md:mb-24 max-w-3xl">
				Τέσσερις αρχές<br />
				Ένα σύστημα
			</h2>

			<div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-light/5">

				<!-- Pillar 1 — Method -->
				<article class="bg-dark p-8 md:p-12 lg:p-16 group">
					<span class="text-lime font-heading text-6xl md:text-7xl leading-none opacity-20 group-hover:opacity-40 transition-opacity duration-300">01</span>
					<h3 class="font-heading text-xl md:text-2xl uppercase tracking-tight mt-6 mb-4 leading-tight">
						Η πρόοδος δεν περιμένει διάθεση<br />
						Χτίζεται με μέθοδο					</h3>
					<p class="text-grey leading-relaxed mb-8 max-w-md">
						Κάθε προπόνηση έχει σκοπό. Ακολουθούμε ένα δομημένο σύστημα προοδευτικής υπερφόρτωσης και περιοδισμού γιατί η μέθοδος φέρνει αποτελέσματα, όχι η τύχη.
					</p>
					<a href="/methodologia" class="text-lime text-sm font-bold tracking-wider uppercase border-b border-lime/30 pb-1 hover:border-lime transition-colors duration-150">
						Δες πώς η μέθοδος φέρνει αποτελέσματα &rarr;
					</a>
				</article>

				<!-- Pillar 2 — Science -->
				<article class="bg-dark p-8 md:p-12 lg:p-16 group">
					<span class="text-lime font-heading text-6xl md:text-7xl leading-none opacity-20 group-hover:opacity-40 transition-opacity duration-300">02</span>
					<h3 class="font-heading text-xl md:text-2xl uppercase tracking-tight mt-6 mb-4 leading-tight">
						Ακολουθούμε δεδομένα					</h3>
					<p class="text-grey leading-relaxed mb-8 max-w-md">
						Κάθε πρόγραμμα βασίζεται στην επιστήμη, όχι σε τάσεις. Παρακολουθούμε τη λειτουργικότητα των επιμέρους προγραμμάτων, τις προσαρμογές και φροντίζουμε την αποκατάσταση ώστε να βλέπεις μετρήσιμα αποτελέσματα.
					</p>
					<a href="/programmata" class="text-lime text-sm font-bold tracking-wider uppercase border-b border-lime/30 pb-1 hover:border-lime transition-colors duration-150">
						Μάθε την επιστήμη πίσω από την πρόοδό σου &rarr;
					</a>
				</article>

				<!-- Pillar 3 — Community -->
				<article class="bg-dark p-8 md:p-12 lg:p-16 group">
					<span class="text-lime font-heading text-6xl md:text-7xl leading-none opacity-20 group-hover:opacity-40 transition-opacity duration-300">03</span>
					<h3 class="font-heading text-xl md:text-2xl uppercase tracking-tight mt-6 mb-4 leading-tight">
						Εδώ η δύναμη<br />
						είναι μεταδοτική					</h3>
					<p class="text-grey leading-relaxed mb-8 max-w-md">
						Η κοινότητα ανεβάζει τα πρότυπά σου. Προπονείσαι δίπλα σε ανθρώπους που μοιράζονται τους ίδιους στόχους και την ίδια νοοτροπία. Γιατί εδώ δεν είσαι πελάτης, είσαι μέλος.
					</p>
					<a href="/koinotita" class="text-lime text-sm font-bold tracking-wider uppercase border-b border-lime/30 pb-1 hover:border-lime transition-colors duration-150">
						Γίνε μέρος της κοινότητας &rarr;
					</a>
				</article>

				<!-- Pillar 4 — Performance -->
				<article class="bg-dark p-8 md:p-12 lg:p-16 group">
					<span class="text-lime font-heading text-6xl md:text-7xl leading-none opacity-20 group-hover:opacity-40 transition-opacity duration-300">04</span>
					<h3 class="font-heading text-xl md:text-2xl uppercase tracking-tight mt-6 mb-4 leading-tight">
						Προπονούμαστε για αποτέλεσμα					</h3>
					<p class="text-grey leading-relaxed mb-8 max-w-md">
						Κάθε μέρα που προπονείσαι είναι μια νίκη. Εδώ δεν μετράμε τον ιδρώτα αλλά την απόδοση και την εξέλιξη.
					</p>
					<a href="/epikoinonia" class="text-lime text-sm font-bold tracking-wider uppercase border-b border-lime/30 pb-1 hover:border-lime transition-colors duration-150">
						Ξεκίνα να χτίζεις τον καλύτερο εαυτό σου &rarr;
					</a>
				</article>

			</div>
		</div>
	</section>

	<!-- ═══════════════════════════════════════════════ -->
	<!-- MANIFESTO / EMOTIONAL HOOK -->
	<!-- ═══════════════════════════════════════════════ -->
	<section id="manifesto" class="py-24 md:py-32 lg:py-40 border-t border-b border-light/5">
		<div class="max-w-7xl mx-auto px-6 md:px-12">
			<div class="max-w-4xl">
				<p class="text-lime font-bold text-sm tracking-[0.3em] uppercase mb-6">
					Manifesto
				</p>
				<h2 class="font-heading text-3xl sm:text-4xl md:text-5xl lg:text-6xl uppercase tracking-tight leading-[1.05] mb-12">
					Reset<span class="text-lime">.</span><br />
					Start clean<span class="text-lime">.</span><br />
					Function again				</h2>

				<div class="space-y-6 text-grey text-lg md:text-xl leading-relaxed max-w-2xl">
					<p>
						Ξεκλείδωσε δυνατότητες που δεν γνώριζες ότι έχεις. Κάθε σύστημα χρειάζεται reset — μια επιστροφή στα βασικά, μια αναβάθμιση στη λειτουργία.
					</p>
					<p>
						Απορρίπτουμε τον άσκοπο ιδρώτα και τα fitness trends. Πιστεύουμε στη δομή, στην επιστήμη, στη μετρήσιμη πρόοδο. Πιστεύουμε ότι η προπόνηση είναι εξέλιξη — και η εξέλιξη δεν σταματάει ποτέ.
					</p>
					<p class="text-light font-bold">
						Εδώ δεν ψάχνεις κίνητρο. Εδώ χτίζεις αυτονομία, κυριαρχία στο σώμα σου, και μια κοινότητα που σε ανεβάζει. Κάθε μέρα.
					</p>
				</div>

				<a
					href="/epikoinonia"
					class="inline-block bg-lime text-dark font-bold text-sm tracking-wider uppercase px-8 py-4 mt-12 hover:translate-x-1 hover:-translate-y-1 transition-transform duration-150"
				>
					Γίνε μέλος
				</a>
			</div>
		</div>
	</section>

</Layout>
